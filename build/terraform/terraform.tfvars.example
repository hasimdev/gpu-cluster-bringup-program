# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
region             = "us-east-1"
instance_type      = "g5.xlarge"
node_count         = 2
key_name           = "my-keypair"
allowed_ssh_cidr   = "203.0.113.10/32"
monthly_budget_usd = 300
budget_alert_email = "you@example.com"
idle_stop_minutes  = 60
